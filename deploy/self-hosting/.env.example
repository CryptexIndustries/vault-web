# Replace the domains. Use DNS-only A records pointing to your VPS.
VAULT_DOMAIN=vault.example.com
SIGNAL_DOMAIN=signal.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=you@example.com
# Resolve the chosen release with docker buildx imagetools inspect IMAGE:TAG.
# Pin the top-level manifest digest, not a mutable tag.
VAULT_IMAGE=ghcr.io/cryptexindustries/vault-web@sha256:REPLACE_WITH_VERIFIED_DIGEST
SHARE_IMAGE=ghcr.io/cryptexindustries/vault-web/share-server@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Source builds only: uncomment this and use local image tags instead.
# COMPOSE_FILE=compose.yaml:compose.build.yaml
# VAULT_IMAGE=cryptex-vault-self-hosted:initial
# SHARE_IMAGE=cryptex-vault-share-server:initial
# Set these to the output of id -u and id -g for the owner of turnserver.conf.
# Use an unprivileged user, not root.
TURN_UID=1000
TURN_GID=1000
# Generate each separately with: openssl rand -hex 32
SOKETI_APP_ID=cryptex-self-hosted
SOKETI_APP_KEY=REPLACE_WITH_RANDOM_HEX
SOKETI_APP_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Creation tokens for one-time share links, comma-separated, 32+ characters
# each. Give one to each person allowed to create links:
# openssl rand -hex 32
SHARE_CREATION_TOKENS=REPLACE_WITH_RANDOM_HEX
# Only behind a CDN or another proxy in front of Caddy. See the guide first.
# SHARE_TRUSTED_PROXY_HOPS=2
# SHARE_CLIENT_IP_HEADER=CF-Connecting-IP
