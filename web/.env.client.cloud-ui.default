# Template for the cloud-ui profile (self-hosted UI, external Cryptex Cloud API).
#
#   cp web/.env.client.cloud-ui.example web/.env.client.cloud-ui
#   docker compose -f compose.client.yaml --profile cloud-ui --env-file web/.env.client.cloud-ui up --build

NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLOUD_ENABLED=true
CLIENT_WEB_PORT=3000

# Origin of your Cryptex Cloud tRPC service (required for cloud-ui profile).
NEXT_PUBLIC_ONLINE_SERVICES_API_URL=https://cloud.example.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_PUSHER_APP_ID=your-pusher-app-id
NEXT_PUBLIC_PUSHER_APP_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_APP_HOST=your-pusher-host
NEXT_PUBLIC_PUSHER_APP_PORT=443
NEXT_PUBLIC_PUSHER_APP_TLS=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
NEXT_PUBLIC_STRIPE_PREMIUM_PRODUCT_ID=prod_...
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
