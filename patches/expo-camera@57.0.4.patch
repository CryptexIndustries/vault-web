+    File(requireNotNull(System.getProperty("cryptex.qrFixtures"))).inputStream().buffered()
+  ).use { input ->
+    assertEquals("QR rotation must remain unchanged", 250, input.readInt())
+    List(input.readInt()) {
+      val text = ByteArray(input.readInt()).also(input::readFully).toString(Charsets.UTF_8)
+      val size = input.readInt()
+      Fixture(text, size, ByteArray(size * size).also(input::readFully))
+    }
+  }
+
+  private inline fun <reified T> proxy(crossinline invoke: (String) -> Any?): T =
+    Proxy.newProxyInstance(T::class.java.classLoader, arrayOf(T::class.java)) { _, method, _ ->
+      invoke(method.name)
+    } as T
+
+  private fun frame(
+    f: Fixture, rotation: Int = 0, inverted: Boolean = false, pixelStride: Int = 1,
+    truncated: Boolean = false, format: Int = ImageFormat.YUV_420_888,
+    cameraRotation: Int = (360 - rotation) % 360, sidePadding: Int = 0, closed: () -> Unit
+  ): ImageProxy {
+    val width = f.size + 2 * sidePadding
+    val stride = width * pixelStride + 19
+    val start = 7
+    // Direct buffer with a nonzero position and no padding after the final pixel.
+    val end = start + (f.size - 1) * stride + (width - 1) * pixelStride + 1
+    val buffer = ByteBuffer.allocateDirect(end)
+    for (i in 0 until end) buffer.put(i, (if (inverted) 0 else 255).toByte())
+    for (y in 0 until f.size) for (x in 0 until f.size) {
+      val index = when (rotation) {
+        90 -> (f.size - 1 - x) * f.size + y
+        180 -> (f.size - 1 - y) * f.size + f.size - 1 - x
+        270 -> x * f.size + f.size - 1 - y
+        else -> y * f.size + x
+      }
+      val value = f.pixels[index].toInt() and 255
+      buffer.put(start + y * stride + (x + sidePadding) * pixelStride, (if (inverted) 255 - value else value).toByte())
+    }
+    buffer.position(start)
+    if (truncated) buffer.limit(end - 1)
+    val plane = proxy<ImageProxy.PlaneProxy> {
+      when (it) {
+        "getBuffer" -> buffer
+        "getRowStride" -> stride
+        "getPixelStride" -> pixelStride
+        else -> error(it)
+      }
+    }
+    return proxy {
+      when (it) {
+        "getWidth" -> width
+        "getHeight" -> f.size
+        "getFormat" -> format
+        "getPlanes" -> arrayOf(plane)
+        "getImageInfo" -> proxy<ImageInfo> { name ->
+          when (name) {
+            "getRotationDegrees" -> cameraRotation
+            else -> error(name)
+          }
+        }
+        "close" -> { closed(); null }
+        else -> error(it)
+      }
+    }
+  }
+
+  @Test fun productionFramesDecodeExactlyThroughRotationAndInversion() {
+    val results = mutableListOf<BarCodeScannerResult>()
+    val analyzer = BarcodeAnalyzer(listOf(BarcodeType.QR)) { results.add(it) }
+    var closed = 0
+    var count = 0
+    for (f in fixtures()) for (rotation in listOf(0, 90, 180, 270)) for (inverted in listOf(false, true)) {
+      analyzer.analyze(frame(f, rotation, inverted, pixelStride = 2, sidePadding = 11) { closed++ })
+      count++
+      assertEquals("Missing result at frame $count", count, results.size)
+      assertEquals(f.text, results.last().value)
+      assertEquals(f.text, results.last().raw)
+      assertEquals("qr", BarcodeType.mapFormatToString(results.last().type))
+    }
+    assertEquals(count, closed)
+  }
+
+  @Test fun repeatedAndOutOfOrderChunksAreNotSuppressed() {
+    val frames = fixtures().filter { it.text.startsWith("CVQ1:") }
+    assertTrue(frames.size > 1)
+    assertTrue(frames.first().text.substringAfterLast(':').length == 750)
+    val expected = frames.reversed() + frames + frames
+    val actual = mutableListOf<String?>()
+    val analyzer = BarcodeAnalyzer(listOf(BarcodeType.QR)) { actual.add(it.value) }
+    var closed = 0
+    expected.forEach { analyzer.analyze(frame(it) { closed++ }) }
+    assertEquals(expected.map { it.text }, actual)
+    assertEquals(expected.size, closed)
+  }
+
+  @Test fun invalidFramesAndCallbackFailuresDoNotLeakFramesOrPoisonReader() {
+    val f = fixtures().first()
+    var closed = 0
+    var callbacks = 0
+    val analyzer = BarcodeAnalyzer(emptyList()) {
+      callbacks++
+      if (callbacks == 1) throw IllegalStateException("Synthetic callback failure")
+      assertEquals(f.text, it.value)
+    }
+    analyzer.analyze(frame(f, truncated = true) { closed++ })
+    analyzer.analyze(frame(f, format = ImageFormat.JPEG) { closed++ })
+    analyzer.analyze(frame(f.copy(pixels = ByteArray(f.size * f.size) { 127 })) { closed++ })
+    assertEquals(0, callbacks)
+    repeat(2) { analyzer.analyze(frame(f) { closed++ }) }
+    assertEquals(2, callbacks)
+    assertEquals(5, closed)
+  }
+
+  @Test fun nonQrRequestsNeverEmitQrResults() {
+    var closed = 0
+    BarcodeAnalyzer(listOf(BarcodeType.EAN13)) { fail("Unexpected QR result") }
+      .analyze(frame(fixtures().first()) { closed++ })
+    assertEquals(1, closed)
+  }
+
+  @Test fun turningTheCodeDoesNotPoisonLaterUprightFrames() {
+    val results = mutableListOf<String?>()
+    val analyzer = BarcodeAnalyzer(listOf(BarcodeType.QR)) { results.add(it.value) }
+    var closed = 0
+    var expected = 0
+    repeat(3) {
+      for (f in fixtures()) for (rotation in listOf(180, 0, 90, 0, 270, 0)) {
+        // The sender turns. The receiving phone and CameraX metadata do not.
+        analyzer.analyze(frame(f, rotation, inverted = it % 2 == 1, cameraRotation = 0, sidePadding = 23) { closed++ })
+        expected++
+        assertEquals("Missing result at frame $expected, code rotation $rotation", expected, results.size)
+        assertEquals(f.text, results.last())
+      }
+    }
+    assertEquals(expected, closed)
+  }
