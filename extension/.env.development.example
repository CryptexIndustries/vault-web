# Defaults for `pnpm dev` / `vite build --mode development`.
# Committed: shared dev defaults. Override locally via `.env.development.local`.

VITE_APP_URL=http://localhost:3000

# Optional Cryptex Cloud tRPC origin. Empty = same as VITE_APP_URL.
# VITE_ONLINE_SERVICES_API_URL=http://localhost:3000

# Set to false for local-only vault (no sign-in, sync, or billing UI).
# VITE_CLOUD_ENABLED=false

# Prepended to manifest `name` and action `default_title` (dev builds only by default).
VITE_EXTENSION_NAME_PREFIX=[DEV]

VITE_PUSHER_APP_ID=a2e0706c-2033-4d09-a728-cb67389cfc46
VITE_PUSHER_APP_KEY=765cf238-0d71-4fa6-b213-63da76522c53
VITE_PUSHER_APP_HOST=localhost
VITE_PUSHER_APP_PORT=6011
VITE_PUSHER_APP_TLS=false
