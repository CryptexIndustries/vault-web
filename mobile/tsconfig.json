{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@/*": ["./src/*"],
            "@ui/*": ["../packages/shared-ui/src/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts"
    ]
}
