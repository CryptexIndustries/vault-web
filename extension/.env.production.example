# Production defaults for `vite build` (mode=production by default).
# Committed: shared production defaults. Override locally via `.env.production.local`.
# TODO: replace all placeholders with real production values before shipping.

# API origin (must be HTTPS in production).
VITE_APP_URL=https://cryptex-vault.com

# Optional prefix for manifest `name` / action `default_title` (e.g. staging builds).
# VITE_EXTENSION_NAME_PREFIX=[STAGING]

# Pusher production tenant. Host MUST resolve over TLS.
VITE_PUSHER_APP_ID=REPLACE_ME
VITE_PUSHER_APP_KEY=REPLACE_ME
VITE_PUSHER_APP_HOST=signaling.cryptex-vault.com
VITE_PUSHER_APP_PORT=443
VITE_PUSHER_APP_TLS=true
