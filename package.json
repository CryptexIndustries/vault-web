{
    "name": "cryptex-vault-web",
    "version": "1.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "workspaces": [
        "web/*",
        "extension/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "pnpm --filter web dev",
        "dev:ext": "pnpm --filter extension dev",
        "build:web": "pnpm --filter web build",
        "build:ext": "pnpm --filter extension build",
        "build": "pnpm build:web && pnpm build:ext",
        "lint:web": "pnpm --filter web lint",
        "lint-tsc:web": "pnpm --filter web lint-tsc",
        "lint-next:web": "pnpm --filter web lint-next",
        "lint:ext": "pnpm --filter extension lint",
        "lint": "pnpm lint:web && pnpm lint:ext",
        "test": "pnpm jest",
        "coverage": "pnpm jest --coverage"
    },
    "devDependencies": {
        "@jest/globals": "29.7.0",
        "@types/node": "20.19.9",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "oxfmt": "0.43.0",
        "oxlint": "1.58.0",
        "oxlint-tsgolint": "0.19.0",
        "ts-jest": "29.4.0",
        "ts-node": "10.9.2",
        "@typescript/native-preview": "7.0.0-dev.20260404.1",
        "pnpm": "10.33.0"
    },
    "engines": {
        "node": ">=20.19.0",
        "pnpm": "10.33.0"
    },
    "pnpm": {
        "overrides": {
            "@tootallnate/once@<2.0.1": "2.0.1",
            "brace-expansion@<1.1.13": "1.1.13",
            "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
            "diff@>=4.0.0 <4.0.4": "4.0.4",
            "glob@>=10.2.0 <10.5.0": "10.5.0",
            "js-yaml@<3.14.2": "3.14.2",
            "minimatch@<3.1.4": "3.1.4",
            "minimatch@>=5.0.0 <5.1.8": "5.1.8",
            "minimatch@>=9.0.0 <9.0.7": "9.0.7",
            "picomatch@<2.3.2": "2.3.2",
            "postcss@<8.5.10": "8.5.15",
            "rollup@>=4.0.0 <4.59.0": "4.60.4",
            "svgo@4.0.0": "4.0.1",
            "ws@>=8.0.0 <8.20.1": "8.21.0",
            "yaml@>=2.0.0 <2.8.3": "2.8.3"
        }
    }
}
