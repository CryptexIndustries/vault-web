{
    "name": "cryptex-vault-web",
    "version": "1.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "workspaces": [
        "web/*",
        "extension/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "pnpm --filter web dev",
        "dev:ext": "pnpm --filter extension dev",
        "build:web": "pnpm --filter web build",
        "build:ext": "pnpm --filter extension build",
        "build": "pnpm build:web && pnpm build:ext",
        "lint:web": "pnpm --filter web lint",
        "lint-tsc:web": "pnpm --filter web lint-tsc",
        "lint-next:web": "pnpm --filter web lint-next",
        "lint:ext": "pnpm --filter extension lint",
        "lint": "pnpm lint:web && pnpm lint:ext",
        "test": "pnpm jest",
        "coverage": "pnpm jest --coverage"
    },
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "@types/node": "^20",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "oxfmt": "0.43.0",
        "oxlint": "1.58.0",
        "oxlint-tsgolint": "0.19.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "@typescript/native-preview": "7.0.0-dev.20260404.1",
        "pnpm": "10.33.0"
    }
}
