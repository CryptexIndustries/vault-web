{
    "manifest_version": 3,
    "minimum_chrome_version": "127",
    "name": "Cryptex Vault - Local-first password manager",
    "version": "1.0.0",
    "description": "Open-source password manager with browser autofill and peer-to-peer sync. Keep your vault local, private, and under your control",
    "icons": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png"
    },
    "action": {
        "default_popup": "/popup.html",
        "default_title": "Cryptex Vault",
        "default_icon": {
            "16": "assets/icons/icon-locked-16.png",
            "32": "assets/icons/icon-locked-32.png",
            "48": "assets/icons/icon-locked-48.png"
        }
    },
    "background": {
        "service_worker": "/background.js",
        "type": "module"
    },
    "permissions": ["storage", "idle", "activeTab"],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "host_permissions": ["https://*/*", "http://*/*"],
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["assets/passkey-page-bridge.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false,
            "match_about_blank": false
        },
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["assets/autofill-cs.js"],
            "run_at": "document_start",
            "all_frames": false,
            "match_about_blank": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "autofill-generator.html",
                "autofill-menu.html",
                "autofill-save.html",
                "assets/*"
            ],
            "matches": ["http://*/*", "https://*/*"]
        }
    ]
}
