EXPO_PUBLIC_CLOUD_ENABLED=true
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_ONLINE_SERVICES_API_URL=http://localhost:3000
# Hosted SSH agent relay; defaults to https://relay.cryptex-vault.com
EXPO_PUBLIC_RELAY_URL=

# Required when EXPO_PUBLIC_CLOUD_ENABLED=true
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_PUSHER_APP_KEY=
EXPO_PUBLIC_PUSHER_APP_HOST=
EXPO_PUBLIC_PUSHER_APP_PORT=
EXPO_PUBLIC_PUSHER_APP_TLS=true
