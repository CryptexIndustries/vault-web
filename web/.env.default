# Client + extension environment (Cryptex Cloud runs from cryptex-vault-cloud)

NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptex Cloud tRPC origin. Empty = same as NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_ONLINE_SERVICES_API_URL=
NEXT_PUBLIC_BACKUP_STORAGE_ORIGIN=

# Set to true when developing against a running Cryptex Cloud stack.
NEXT_PUBLIC_CLOUD_ENABLED=false

# Captcha - Cloudflare Turnstile (required when cloud sign-up is enabled)
# Always succeed - 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Pusher (client — signaling when using online services)
NEXT_PUBLIC_PUSHER_APP_ID="f2ec2da3-57d3-4904-bd9d-3e813978daba"
NEXT_PUBLIC_PUSHER_APP_KEY="16134c4f-0aa5-4164-a2c6-cc6ce763af60"
NEXT_PUBLIC_PUSHER_APP_HOST="localhost"
NEXT_PUBLIC_PUSHER_APP_PORT=6004
NEXT_PUBLIC_PUSHER_APP_TLS=false

# Stripe (client-side checkout only; secrets live in cryptex-vault-cloud)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51LmLWuJPKozluKWZvdhJOtmKWOCKT3YM3nJzoYhbMBRhIQoQnZ2ckXWPAKnHlvXqGCciInKUa8VUfGijQ7LRcvGa00tpij7UyI
