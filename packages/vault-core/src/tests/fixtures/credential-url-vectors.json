    "registrableDomains": [
        {
            "hostname": "www.example.co.uk",
            "expected": "example.co.uk"
        },
        {
            "hostname": "EXAMPLE.com.",
            "expected": "example.com"
        },
        {
            "hostname": "com",
            "expected": null
        },
        {
            "hostname": "foo.bar.ck",
            "expected": "foo.bar.ck"
        },
        {
            "hostname": "bar.ck",
            "expected": null
        },
        {
            "hostname": "www.ck",
            "expected": "www.ck"
        },
        {
            "hostname": "my-site.github.io",
            "expected": "my-site.github.io"
        },
        {
            "hostname": "xn--bcher-kva.de",
            "expected": "xn--bcher-kva.de"
        },
        {
            "hostname": "a_b.example.com",
            "expected": "example.com"
        },
        {
            "hostname": "-bad.example.com",
            "expected": null
        },
        {
            "hostname": "printer.local",
            "expected": null
        },
        {
            "hostname": "localhost",
            "expected": null
        },
        {
            "hostname": "192.168.1.1",
            "expected": "1.1",
            "note": "psl treats IPv4 addresses as unlisted domains."
        }
    ],
    "matches": [
        {
            "name": "exact host on a deeper path",
            "credential": {
                "URL": "https://login.example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://login.example.com/account",
            "expected": 3
        },
        {
            "name": "exact host keeps the parent separate",
            "credential": {
                "URL": "https://login.example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://example.com",
            "expected": null
        },
        {
            "name": "exact host keeps siblings separate",
            "credential": {
                "URL": "https://login.example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://evil.example.com",
            "expected": null
        },
        {
            "name": "exact host ignores case, default port and a trailing dot",
            "credential": {
                "URL": "example.com.",
                "URLMatchMode": 0
            },
            "pageUrl": "https://EXAMPLE.com:443/",
            "expected": 3
        },
        {
            "name": "domain mode matches a sibling",
            "credential": {
                "URL": "https://www.example.com/en",
                "URLMatchMode": 1
            },
            "pageUrl": "https://app.example.com/",
            "expected": 1
        },
        {
            "name": "domain mode matches the same host as exact",
            "credential": {
                "URL": "https://www.example.com/en",
                "URLMatchMode": 1
            },
            "pageUrl": "https://www.example.com/de",
            "expected": 1
        },
        {
            "name": "domain mode stops at the public suffix",
            "credential": {
                "URL": "https://one.github.io",
                "URLMatchMode": 1
            },
            "pageUrl": "https://two.github.io",
            "expected": null
        },
        {
            "name": "domain mode without a registrable domain needs the same host",
            "credential": {
                "URL": "http://localhost:3000",
                "URLMatchMode": 1
            },
            "pageUrl": "http://localhost:3000/login",
            "expected": 3
        },
        {
            "name": "domain mode treats IPv4 addresses as psl does",
            "credential": {
                "URL": "http://192.168.1.1",
                "URLMatchMode": 1
            },
            "pageUrl": "http://10.0.1.1",
            "expected": 1,
            "note": "Both 192.168.1.1 and 10.0.1.1 have the registrable domain 1.1."
        },
        {
            "name": "an https login never goes to http",
            "credential": {
                "URL": "https://example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "http://example.com",
            "expected": null
        },
        {
            "name": "an http login may go to https",
            "credential": {
                "URL": "http://example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://example.com",
            "expected": 3
        },
        {
            "name": "ports must agree",
            "credential": {
                "URL": "example.com:8443",
                "URLMatchMode": 0
            },
            "pageUrl": "https://example.com/",
            "expected": null
        },
        {
            "name": "the same port matches",
            "credential": {
                "URL": "example.com:8443",
                "URLMatchMode": 0
            },
            "pageUrl": "https://example.com:8443/",
            "expected": 3
        },
        {
            "name": "ports can be ignored",
            "credential": {
                "URL": "example.com:8443",
                "URLMatchMode": 0
            },
            "pageUrl": "https://example.com",
            "ignorePort": true,
            "expected": 3
        },
        {
            "name": "a wildcard label matches one label",
            "credential": {
                "URL": "*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "https://a.example.com",
            "expected": 2
        },
        {
            "name": "a wildcard label needs a label",
            "credential": {
                "URL": "*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "https://example.com",
            "expected": null
        },
        {
            "name": "a wildcard label does not cross dots",
            "credential": {
                "URL": "*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "https://a.b.example.com",
            "expected": null
        },
        {
            "name": "a wildcard in the middle",
            "credential": {
                "URL": "https://api.*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "https://API.eu.example.com/v1",
            "expected": 2
        },
        {
            "name": "a path star stays within a segment",
            "credential": {
                "URL": "https://*.example.com/app/*",
                "URLMatchMode": 2
            },
            "pageUrl": "https://x.example.com/app/home",
            "expected": 2
        },
        {
            "name": "a path star does not cross segments",
            "credential": {
                "URL": "https://*.example.com/app/*",
                "URLMatchMode": 2
            },
            "pageUrl": "https://x.example.com/app/home/deep",
            "expected": null
        },
        {
            "name": "a double path star crosses segments",
            "credential": {
                "URL": "https://*.example.com/app/**",
                "URLMatchMode": 2
            },
            "pageUrl": "https://x.example.com/app/home/deep",
            "expected": 2
        },
        {
            "name": "other path characters are literal",
            "credential": {
                "URL": "https://*.example.com/a.b+(c)",
                "URLMatchMode": 2
            },
            "pageUrl": "https://x.example.com/aXb+(c)",
            "expected": null
        },
        {
            "name": "a wildcard may not cover the registrable domain",
            "credential": {
                "URL": "*.co.uk",
                "URLMatchMode": 2
            },
            "pageUrl": "https://example.co.uk",
            "expected": null
        },
        {
            "name": "a partial wildcard label is invalid",
            "credential": {
                "URL": "a*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "https://ab.example.com",
            "expected": null
        },
        {
            "name": "a wildcard rule checks the scheme",
            "credential": {
                "URL": "https://*.example.com",
                "URLMatchMode": 2
            },
            "pageUrl": "http://a.example.com",
            "expected": null
        },
        {
            "name": "the best rule wins",
            "credential": {
                "URL": "https://www.example.com",
                "URLMatchMode": 1,
                "AdditionalURLs": [
                    {
                        "URL": "*.example.com",
                        "MatchMode": 2
                    },
                    {
                        "URL": "https://www.example.com",
                        "MatchMode": 0
                    }
                ]
            },
            "pageUrl": "https://www.example.com",
            "expected": 3
        },
        {
            "name": "an additional URL matches when the primary is empty",
            "credential": {
                "URL": " ",
                "URLMatchMode": 0,
                "AdditionalURLs": [
                    {
                        "URL": "*.example.net",
                        "MatchMode": 2
                    }
                ]
            },
            "pageUrl": "https://accounts.example.net",
            "expected": 2
        },
        {
            "name": "an unknown match mode matches by domain",
            "credential": {
                "URL": "https://www.example.com",
                "URLMatchMode": 7
            },
            "pageUrl": "https://shop.example.com",
            "expected": 1
        },
        {
            "name": "an app association never matches a website",
            "credential": {
                "URL": "androidapp://com.example",
                "URLMatchMode": 0
            },
            "pageUrl": "https://com.example",
            "expected": null
        },
        {
            "name": "an internationalized name matches its punycode",
            "credential": {
                "URL": "bücher.de",
                "URLMatchMode": 0
            },
            "pageUrl": "https://xn--bcher-kva.de/",
            "expected": 3
        },
        {
            "name": "an internationalized name maps compatibility characters as browsers do",
            "credential": {
                "URL": "https://ϲa.example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://xn--a-zmb.example.com",
            "expected": 3
        },
        {
            "name": "an internationalized name doesn't match a look-alike punycode",
            "credential": {
                "URL": "https://ϲa.example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "https://xn--a-xmb.example.com",
            "expected": null
        },
        {
            "name": "IPv6 addresses match in their shortest form",
            "credential": {
                "URL": "https://[::1]:8443",
                "URLMatchMode": 0
            },
            "pageUrl": "https://[0::1]:8443/x",
            "expected": 3
        },
        {
            "name": "IPv6 ports must agree",
            "credential": {
                "URL": "https://[::1]:8443",
                "URLMatchMode": 0
            },
            "pageUrl": "https://[::1]/",
            "expected": null
        },
        {
            "name": "domain mode compares whole IPv6 addresses",
            "credential": {
                "URL": "https://[::1]",
                "URLMatchMode": 1
            },
            "pageUrl": "https://[::2]/",
            "expected": null
        },
        {
            "name": "an unparsable page matches nothing",
            "credential": {
                "URL": "https://example.com",
                "URLMatchMode": 0
            },
            "pageUrl": "not a url",
            "expected": null
        }
    ],
    "rules": [
        {
            "rule": {
                "URL": "https://example.com",
                "MatchMode": 0
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "example.com/login",
                "MatchMode": 1
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "localhost:8080",
                "MatchMode": 0
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "",
                "MatchMode": 0
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "ftp://example.com",
                "MatchMode": 0
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "not a url",
                "MatchMode": 0
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "androidapp://com.example.app",
                "MatchMode": 0
            },
            "expected": true
        },
        {
            "rule": {
                "URL": " ANDROIDAPP://Com.Example.App ",
                "MatchMode": 0
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "androidapp://com.example.app",
                "MatchMode": 1
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "androidapp://com.example.app/",
                "MatchMode": 0
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "androidapp://singlelabel",
                "MatchMode": 0
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "https://*.example.com",
                "MatchMode": 2
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "*.example.com/**",
                "MatchMode": 2
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "https://*.*.example.co.uk",
                "MatchMode": 2
            },
            "expected": true
        },
        {
            "rule": {
                "URL": "https://*.com",
                "MatchMode": 2
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "https://*.co.uk",
                "MatchMode": 2
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "https://example.com",
                "MatchMode": 2
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "https://a*.example.com",
                "MatchMode": 2
            },
            "expected": false
        },
        {
            "rule": {
                "URL": "https://*.example.com",
                "MatchMode": 0
            },
            "expected": true
        }
    ]
}
