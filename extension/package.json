{
    "name": "extension",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rm -rf dist",
        "dev:main": "NODE_ENV=development vite build --mode development --watch --config vite.config.ts",
        "dev:content": "NODE_ENV=development vite build --mode development --watch --config vite.config.content.ts",
        "dev": "pnpm run clean && pnpm run --parallel \"/^dev:.*/\"",
        "build": "pnpm run clean && vite build --config vite.config.ts && vite build --config vite.config.content.ts",
        "preview": "vite preview",
        "lint": "oxlint",
        "lint-tsc": "tsgo --watch --noEmit --strict",
        "fmt": "oxfmt",
        "fmt-check": "oxfmt --check"
    },
    "dependencies": {
        "@cryptex-industries/shared-ui": "workspace:*",
        "@hookform/resolvers": "3.10.0",
        "@scure/bip39": "2.2.0",
        "@tanstack/react-query": "5.83.0",
        "@trpc/client": "11.17.0",
        "clsx": "2.1.1",
        "dexie": "3.2.7",
        "dexie-react-hooks": "1.1.7",
        "jotai": "2.12.5",
        "lucide-react": "0.511.0",
        "neverthrow": "8.2.0",
        "otpauth": "9.4.0",
        "pusher-js": "8.4.0",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "react-hook-form": "7.60.0",
        "@yudiel/react-qr-scanner": "2.6.0",
        "sonner": "2.0.7",
        "superjson": "2.2.2",
        "ulidx": "2.4.1",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/chrome": "0.1.4",
        "@types/react": "19.1.8",
        "@types/react-dom": "19.1.6",
        "@vitejs/plugin-react": "6.0.2",
        "autoprefixer": "10.4.21",
        "postcss": "8.5.15",
        "tailwindcss": "3.4.17",
        "terser": "5.48.0",
        "typescript": "5.8.3",
        "vite": "8.0.14"
    }
}
