{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "react",
        "react-perf",
        "nextjs",
        "jest"
    ],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "eslint/no-unused-vars": "warn",
        "typescript/no-floating-promises": "off"
    },
    "overrides": [
        {
            "files": ["**/*.test.ts", "**/*.test.tsx"],
            "rules": {
                "jest/no-conditional-expect": "off"
            }
        }
    ],
    "options": {},
    "env": {
        "builtin": true
    },
    "ignorePatterns": [
        "**/.mobile-build/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/out/**",
        "**/coverage/**",
        "**/.next/**",
        "**/*.d.ts"
    ]
}
