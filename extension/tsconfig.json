{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["dom", "esnext"],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["chrome", "react", "react-dom"],
        "paths": {
            "@/*": ["../web/src/*"],
            "@ui/*": ["../packages/shared-ui/src/*"],
            "@cryptex-industries/shared-ui/*": ["../packages/shared-ui/*"],
            "@cryptex-industries/vault-core": [
                "../packages/vault-core/src/index.ts"
            ],
            "@cryptex-industries/vault-core/*": [
                "../packages/vault-core/src/*"
            ],
            "../env/client.mjs": ["./src/env.ts"],
            "../../env/client.mjs": ["./src/env.ts"],
            "@/env/client.mjs": ["./src/env.ts"],
            "../utils/trpc": ["./src/trpc-ext.ts"],
            "@/utils/trpc": ["./src/trpc-ext.ts"],
            "@/app_lib/online-services-session/port": [
                "../packages/vault-core/src/online-services-session/port.ts"
            ],
            "@/app_lib/online-services-session/protocol": [
                "../packages/vault-core/src/online-services-session/protocol.ts"
            ],
            "@/app_lib/online-services-session": [
                "./src/app_lib/online-services-session/extension.ts"
            ]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "vite-env.d.ts"],
    "exclude": ["node_modules"]
}
